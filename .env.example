# =====================================================================
# Variabel lingkungan Belanjaku
# Salin menjadi .env.local (komputer) atau isi di Vercel → Settings → Environment Variables.
# Nilainya ada di Supabase → Project Settings → API Keys (dan Data API untuk URL).
# =====================================================================

# URL project Supabase, mis. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Kunci PUBLIK (Publishable key "sb_publishable_..." atau anon key lama) — aman di browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Kunci RAHASIA (Secret key "sb_secret_..." atau service_role lama) — HANYA di server.
# Dipakai API kelola pengguna (tambah/ubah/hapus akun, atur ulang kata sandi).
# JANGAN diberi awalan NEXT_PUBLIC_ dan jangan dibagikan.
SUPABASE_SECRET_KEY=
